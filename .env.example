DATABASE_URL=postgres://tollgate:tollgate@localhost:5432/tollgate?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# openssl rand -hex 32
ENCRYPTION_KEY=
BASE_URL=http://localhost:4000
PORT=4000
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted
TRUSTED_PROXIES=
# true only for plain-http local dev
COOKIE_INSECURE=false
SPEND_RETENTION_DAYS=90
# Host ports docker compose publishes Postgres/Redis on (change if already in use;
# update DATABASE_URL/REDIS_URL above to match for non-compose runs)
POSTGRES_PORT=5432
REDIS_PORT=6379
